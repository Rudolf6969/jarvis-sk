+def _split_ctrl(text: str, ctrl: str | None):
+    """ZMENENE (lokalna uprava): model obcas pred riadiaci riadok prida vetu ("Idem na to." a pod nou TASK ...).
+    Vrati (co povedat nahlas, nedopovedany zvysok, riadiaci riadok). Riadok, ktory zacina TASK, LOOKUP alebo
+    STOPTASK, sa nahlas nepovie a spracuje sa ako prikaz."""
+    if ctrl is not None:
+        return "", "", ctrl + text
+    m = re.search(r"(?:^|\n)[ \t]*(?=TASK |LOOKUP|STOPTASK)", text)
+    if m:
+        return text[:m.start()], "", text[m.end():]
+    cut = text.rfind("\n")
+    last = text[cut + 1:].lstrip()
+    if cut >= 0 and last and any(c.startswith(last[:len(c)]) for c in ("TASK ", "LOOKUP", "STOPTASK")):
+        return text[:cut + 1], text[cut + 1:], None
+    return text, "", None
+
